---
import Header from '../components/Header.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../utils/paths';
---

<SiteLayout
  title="Privacy Notice | Trainer J Fitness"
  description="How Trainer J Fitness handles information submitted through this website."
>
  <Header />
  <main class="legal-page" id="main-content">
    <article class="shell legal-content">
      <h1>Privacy notice</h1>
      <p class="legal-intro">
        This notice explains what Trainer J Fitness collects through this website and how that information is used.
      </p>

      <h2>Information you choose to share</h2>
      <p>
        The contact form may collect your name, email address, phone number, service interest, and the message you write. Please do not include medical records, insurance information, or other sensitive details in the form.
      </p>

      <h2>How information is used</h2>
      <p>
        Information you submit is used to answer your question, discuss coaching options, and follow up about services you asked about. It is not sold.
      </p>

      <h2>Service providers and outside links</h2>
      <p>
        This website is designed for static hosting and its contact form may be processed by the hosting provider. Booking links open Calendly, and social links open Instagram. Those services have their own privacy practices.
      </p>

      <h2>Your choices</h2>
      <p>
        You can ask to review, correct, or delete information you submitted by emailing <a href="mailto:Jacob@TrainerJFitness.com">Jacob@TrainerJFitness.com</a>.
      </p>

      <h2>Questions</h2>
      <p>
        If you have a question about this notice, email <a href="mailto:Jacob@TrainerJFitness.com">Jacob@TrainerJFitness.com</a>.
      </p>

      <p class="legal-updated">Last updated July 16, 2026.</p>
      <a class="text-link" href={withBase()}><span>Return to the home page</span></a>
    </article>
  </main>
</SiteLayout>
