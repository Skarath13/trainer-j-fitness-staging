---
import { Image } from 'astro:assets';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { isStaging, withBase } from '../utils/paths';

import pattyPhoto from '../assets/images/patty-transformation.jpg';
import weissPhoto from '../assets/images/weiss-transformation.jpg';
import jessePhoto from '../assets/images/jesse-transformation.jpg';

const bookingUrl = 'https://calendly.com/jacob-trainerjfitness/30min';

const transformations = [
  {
    image: pattyPhoto,
    alt: 'Patty before and after 12 weeks of personal training',
    name: 'Patty',
    timeframe: '12 weeks of private training',
    before: 'Oct 2025',
    after: 'Jan 2026',
    title: 'A routine that finally felt sustainable.',
    quote:
      'For the first time in my life, I saw visible results. Jacob was kind, realistic, and assertive. It became a lifestyle, not just a program.',
  },
  {
    image: weissPhoto,
    alt: 'Weiss before and after personal training',
    name: 'Weiss, M.D.',
    timeframe: 'Private training',
    before: 'Jan 2026',
    after: 'Apr 2026',
    title: 'Moving with less fear and more confidence.',
    quote:
      'I was dealing with chronic back pain and sciatica. In three to six months, I was moving better, building muscle, and feeling stronger than I had in years.',
  },
  {
    image: jessePhoto,
    alt: 'Jesse before and after a year of personal training',
    name: 'Jesse',
    timeframe: 'One year of private training',
    before: 'Jul 2024',
    after: 'Jul 2025',
    title: 'A way back to strength after heart surgery.',
    quote:
      'After three heart surgeries, I was nervous to exercise at all. Training with Jacob gave me my life back. My strength and energy are higher than they were in my 20s.',
  },
];

const programs = [
  {
    icon: 'dumbbell',
    title: 'Private training',
    hook: 'You want someone paying attention to the details.',
    body:
      'One-on-one sessions give Jacob room to watch every rep, make adjustments in real time, and keep the plan moving at the right pace for you.',
  },
  {
    icon: 'users',
    title: 'Semi-private training',
    hook: 'You want personal coaching with a little more energy in the room.',
    body:
      'Train alongside one or two other clients while still following your own program. You get close coaching, shared momentum, and a more accessible format.',
  },
  {
    icon: 'device-laptop',
    title: 'Online coaching',
    hook: 'You need structure that travels with you.',
    body:
      'Get a custom plan in Trainerize, progress check-ins, and direct feedback from Jacob. It is a practical fit when location or schedule makes in-person training harder.',
  },
] as const;

const voices = [
  {
    quote:
      'Jacob completely changed my mindset. Training no longer feels negative or restrictive. It feels empowering.',
    name: 'Amber',
    detail: 'Private training',
  },
  {
    quote:
      'I have a much better relationship with food and I have seen an immense increase in lower-body strength. The change feels sustainable.',
    name: 'Monica R.',
    detail: 'Private training',
  },
  {
    quote:
      'My wife had never enjoyed personal training until we started working with Jacob. He recognizes that every person is different.',
    name: 'Jonny L.',
    detail: 'Private training',
  },
];

const faqs = [
  {
    question: 'What if I feel out of place in a gym?',
    answer:
      'That is a completely reasonable place to start. Jacob explains what you are doing, watches the details, and builds the pace around your current ability. You will not be expected to already know the equipment or the exercises.',
  },
  {
    question: 'How do I choose between private, semi-private, and online coaching?',
    answer:
      'You do not have to choose before you reach out. The free consultation is a chance to talk through your schedule, comfort level, and how much hands-on support you want. Jacob can help you decide what makes sense.',
  },
  {
    question: 'Where does in-person training happen?',
    answer:
      'In-person sessions are offered in Irvine at 16782 Hale Avenue, Suite A. Your booking confirmation will include the current visit details.',
  },
  {
    question: 'What happens during the free consultation?',
    answer:
      'It is a 30-minute conversation about what you want, what has made progress difficult, and what kind of support might help. There is no pressure to have a perfect goal or commit on the spot.',
  },
  {
    question: 'Do I need to get in shape before I start?',
    answer:
      'No. Getting started is the point. Your plan begins with what you can do now and builds from there.',
  },
];
---

<SiteLayout
  title="Personal Trainer in Orange County | Trainer J Fitness"
  description="Personal training, semi-private coaching, and online coaching with Jacob Hernandez, M.S., ACE-CPT in Orange County, California."
>
  <Header />
  <main id="main-content">
    <Hero />

    <section class="section results-section" id="results">
      <div class="shell">
        <SectionHeading
          title="Start where you are. See what can change."
          intro="Patty did not need an extreme reset. She needed a plan she could live with and a coach who knew when to push and when to listen."
        />

        <div class="transformation-list">
          {
            transformations.slice(0, 1).map((result, index) => (
              <article class:list={['transformation-card', { 'transformation-card-reverse': index % 2 === 1 }]}>
                <figure class="transformation-figure">
                  <figcaption class="transformation-dates">
                    <span>Before <strong>· {result.before}</strong></span>
                    <span>After <strong>· {result.after}</strong></span>
                  </figcaption>
                  <Image
                    src={result.image}
                    alt={result.alt}
                    class="transformation-image"
                    widths={[480, 720, 960]}
                    sizes="(max-width: 800px) 100vw, 50vw"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    format="webp"
                  />
                </figure>
                <div class="transformation-copy">
                  <h3>{result.title}</h3>
                  <blockquote>
                    <p>“{result.quote}”</p>
                    <footer>
                      <strong>{result.name}</strong>
                      <span>{result.timeframe}</span>
                    </footer>
                  </blockquote>
                  <a class="text-link" href={bookingUrl} target="_blank" rel="noreferrer">
                    <span>Talk with Jacob</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <section class="section coaching-section" id="coaching">
      <div class="shell">
        <SectionHeading
          title="Pick the support that fits your life."
          intro="Some people want every rep watched. Others need a plan they can follow from anywhere. Start with the format that makes showing up easier."
          invert={true}
        />

        <div class="program-grid">
          {
            programs.map((program) => (
              <article class="program-card">
                <span class="program-icon"><Icon name={program.icon} /></span>
                <h3>{program.title}</h3>
                <p class="program-hook">{program.hook}</p>
                <p>{program.body}</p>
                <a href={bookingUrl} target="_blank" rel="noreferrer">Talk through your options</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section more-results-section">
      <div class="shell">
        <SectionHeading
          title="Strength can mean more than one thing."
          intro="For some clients, progress means moving without fear. For others, it means feeling capable again after a difficult health chapter."
        />

        <div class="transformation-list">
          {
            transformations.slice(1).map((result, index) => (
              <article class:list={['transformation-card', { 'transformation-card-reverse': index % 2 === 0 }]}>
                <figure class="transformation-figure">
                  <figcaption class="transformation-dates">
                    <span>Before <strong>· {result.before}</strong></span>
                    <span>After <strong>· {result.after}</strong></span>
                  </figcaption>
                  <Image
                    src={result.image}
                    alt={result.alt}
                    class="transformation-image"
                    widths={[480, 720, 960]}
                    sizes="(max-width: 800px) 100vw, 50vw"
                    loading="lazy"
                    format="webp"
                  />
                </figure>
                <div class="transformation-copy">
                  <h3>{result.title}</h3>
                  <blockquote>
                    <p>“{result.quote}”</p>
                    <footer>
                      <strong>{result.name}</strong>
                      <span>{result.timeframe}</span>
                    </footer>
                  </blockquote>
                  <a class="text-link" href={bookingUrl} target="_blank" rel="noreferrer">
                    <span>Talk with Jacob</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>

        <p class="results-note">
          Every person responds differently. These stories describe individual experiences, not guaranteed results. Exercise coaching is not medical treatment.
        </p>
      </div>
    </section>

    <section class="section about-section" id="about">
      <div class="shell about-layout">
        <div class="about-copy">
          <SectionHeading
            title="A coach should push you and pay attention."
            intro="Jacob has a master's degree in exercise science and an ACE personal training certification. He pays attention to how you move, explains what matters, and adjusts the plan when your body or your week changes."
            align="left"
          />
          <p>
            You will be pushed, but you will also be heard. That balance matters when you are new to training, returning after time away, or carrying a history that makes exercise feel uncertain.
          </p>
          <a class="button button-dark" href={bookingUrl} target="_blank" rel="noreferrer">
            Meet Jacob for 30 minutes
          </a>
        </div>

        <dl class="credential-panel">
          <div>
            <dt><Icon name="school" /><span>Master's in Exercise Science</span></dt>
            <dd>Graduate-level study in biomechanics and program design.</dd>
          </div>
          <div>
            <dt><Icon name="certificate" /><span>ACE Certified Personal Trainer</span></dt>
            <dd>Nationally recognized training focused on safe, effective coaching.</dd>
          </div>
          <div>
            <dt><Icon name="user-check" /><span>Experience across starting points</span></dt>
            <dd>From first-time trainees to clients rebuilding confidence after a difficult health chapter.</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section process-section" id="process">
      <div class="shell">
        <SectionHeading
          title="Here is what happens next."
          intro="You talk first. Jacob learns what has been hard, what you want back, and what your week actually looks like. Then you build from there."
          invert={true}
        />

        <ol class="process-list">
          <li>
            <span>1</span>
            <h3>Talk honestly</h3>
            <p>Share your goals, history, concerns, and schedule. No pressure and no need to have it all figured out.</p>
          </li>
          <li>
            <span>2</span>
            <h3>See how you move</h3>
            <p>A practical movement assessment helps Jacob understand where to begin and what deserves extra care.</p>
          </li>
          <li>
            <span>3</span>
            <h3>Build your plan</h3>
            <p>Your program reflects your current ability, your real week, and the progress you want to feel outside the gym.</p>
          </li>
          <li>
            <span>4</span>
            <h3>Keep adjusting</h3>
            <p>You train, learn, and build momentum. If your schedule or body changes, the plan changes with you.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section voices-section" id="reviews">
      <div class="shell">
        <SectionHeading
          title="What clients say about working with Jacob."
          intro="They remember being listened to, being challenged without being ignored, and finding a way to keep going."
        />

        <div class="voice-grid">
          {
            voices.map((voice) => (
              <figure class="voice-card">
                <blockquote>“{voice.quote}”</blockquote>
                <figcaption>
                  <strong>{voice.name}</strong>
                  <span>{voice.detail}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="shell faq-layout">
        <SectionHeading
          title="Questions before you start."
          intro="You are allowed to be unsure. Here are a few honest answers before you reach out."
          align="left"
        />

        <div class="faq-list">
          {
            faqs.map((item, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section contact-section" id="contact">
      <div class="shell contact-layout">
        <div class="contact-copy">
          <h2>Not sure you are ready? Let’s talk anyway.</h2>
          <p>
            You do not need the perfect goal or the right words. Tell Jacob what has been getting in the way. He will listen and help you decide whether coaching makes sense.
          </p>
          <a class="button" href={bookingUrl} target="_blank" rel="noreferrer">Book on Calendly</a>
          <p class="contact-response">Jacob usually responds within 24 hours.</p>
        </div>

        <form
          class="contact-form"
          name="contact"
          method={isStaging ? 'GET' : 'POST'}
          action={withBase('thanks/')}
          data-netlify={isStaging ? undefined : 'true'}
          netlify-honeypot={isStaging ? undefined : 'bot-field'}
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="honeypot" aria-hidden="true">
            <label>
              Do not fill this out:
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>
          <div class="field-row">
            <div class="field">
              <label for="first-name">First name</label>
              <input id="first-name" name="first-name" type="text" autocomplete="given-name" required />
            </div>
            <div class="field">
              <label for="last-name">Last name</label>
              <input id="last-name" name="last-name" type="text" autocomplete="family-name" required />
            </div>
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="phone">Phone <span>Optional</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="training-type">What sounds most useful?</label>
            <select id="training-type" name="training-type">
              <option value="">I am not sure yet</option>
              <option value="private">Private training</option>
              <option value="semi-private">Semi-private training</option>
              <option value="online">Online coaching</option>
            </select>
          </div>
          <div class="field">
            <label for="message">What would you like help with?</label>
            <textarea id="message" name="message" rows="5"></textarea>
          </div>
          <button class="button form-submit" type="submit">Send a message</button>
          <p class="form-note">
            By sending this form, you agree to the <a href={withBase('privacy/')}>privacy notice</a>.
          </p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <div>
        <a class="footer-brand" href={withBase()}>Trainer J Fitness</a>
        <p>Strength coaching with care in Orange County, California.</p>
      </div>
      <nav aria-label="Footer">
        <a href="mailto:Jacob@TrainerJFitness.com"><Icon name="mail" /><span>Email Jacob</span></a>
        <a href="https://instagram.com/trainerj.cpt" target="_blank" rel="noreferrer">
          <Icon name="brand-instagram" /><span>Instagram</span>
        </a>
        <a href={bookingUrl} target="_blank" rel="noreferrer">
          <Icon name="calendar-event" /><span>Book a consult</span>
        </a>
        <a href={withBase('privacy/')}><Icon name="shield-lock" /><span>Privacy</span></a>
      </nav>
    </div>
  </footer>
</SiteLayout>

<script>
  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('.faq-item'));

  faqItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!item.open) return;

      faqItems.forEach((otherItem) => {
        if (otherItem !== item) otherItem.open = false;
      });
    });
  });
</script>
